# Copy to apps/web/.env.local and fill in. Never commit real values.

# Optional locally, REQUIRED on public hosting. Use the Neon connection URL with sslmode=require.
DATABASE_URL=

# Public HTTPS origin without a trailing slash. Blank means loopback only.
# Vercel: set the exact public project URL here. Render supplies RENDER_EXTERNAL_URL.
APP_ORIGIN=

# Separate random bootstrap secret, at least 32 characters. Never share with learners.
# Used once to enroll the first staff administrator at /review, not for review access.
REVIEW_ADMIN_TOKEN=

# Groq free-plan key. Copy this file to apps/web/.env.local for Next.js.
# Never use a NEXT_PUBLIC_ prefix for this key.
GROQ_API_KEY=

# Groq model IDs. See docs/adr/0005-local-walkthrough-groq.md.
# The verifier must be a different model from the story generator.
STORY_MODEL=openai/gpt-oss-120b
VERIFIER_MODEL=openai/gpt-oss-20b
NOTES_MODEL=openai/gpt-oss-20b

# Only used locally when DATABASE_URL is empty. Never used for hosted accounts.
LOCAL_DATA_DIR=.local-data

# Persisted quotas protect the shared Groq free-plan budget. Failed generations count too.
MAX_DAILY_STORIES=60
MAX_DAILY_STORIES_PER_USER=10
MAX_DAILY_REGISTRATIONS=100
MAX_DAILY_TRANSCRIPTIONS=100
SPEECH_MODEL=whisper-large-v3

# Leave false on Render. Only enable behind a private proxy that overwrites X-BB-Client-IP.
TRUST_PROXY=false

# Groq speech uses GROQ_API_KEY, only after consent and server-side age checks.
